{
  "name": "f-sri",
  "version": "2.0.0",
  "description": "F Sri - Sistema de facturación electrónica para Ecuador con integración al SRI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:ci",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "e2e:sri": "bash scripts/e2e-sri-pruebas.sh"
  },
  "keywords": [
    "facturacion-electronica",
    "sri",
    "ecuador",
    "invoicing",
    "electronic-billing",
    "nodejs",
    "typescript",
    "mongodb",
    "express",
    "f-sri"
  ],
  "author": "F Sri Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XaviMontero/f-sri.git"
  },
  "bugs": {
    "url": "https://github.com/XaviMontero/f-sri/issues"
  },
  "homepage": "https://github.com/XaviMontero/f-sri#readme",
  "dependencies": {
    "@types/cors": "^2.8.18",
    "@types/nodemailer": "^6.4.17",
    "@xmldom/xmldom": "^0.8.10",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firmaec.js": "file:vendor/firmaec.js-5.2.0.tgz",
    "jsbarcode": "^3.11.6",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.15.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^7.0.13",
    "puppeteer": "^24.9.0",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.11",
    "@types/supertest": "^2.0.12",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint-config-prettier": "^10.1.5",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.5.3",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
